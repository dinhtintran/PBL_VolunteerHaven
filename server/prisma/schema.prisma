generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  password     String
  fullName     String
  userType     String
  bio          String?
  profileImage String?
  isApproved   Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  proofFiles    String[]
  
  campaigns    Campaign[] @relation("OrganizationCampaigns")
  donations    Donation[] @relation("UserDonations")

  @@map("users") // <- ánh xạ model User sang bảng users
}

model Campaign {
  id             Int        @id @default(autoincrement())
  title          String
  description    String
  goalAmount     Float
  currentAmount  Float      @default(0)
  organizationId Int
  organization   User       @relation("OrganizationCampaigns", fields: [organizationId], references: [id])
  imageUrl       String?
  startDate      DateTime
  endDate        DateTime
  createdAt      DateTime   @default(now())
  isActive       Boolean    @default(true)
  isApproved     Boolean    @default(false)

  donations      Donation[]
  categories     Category[] @relation("CampaignCategories") // Quan hệ nhiều-nhiều với Category

  
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  description String
  imageUrl    String?
  campaignCount Int      @default(0)

  campaigns   Campaign[] @relation("CampaignCategories") // Quan hệ nhiều-nhiều với Campaign
}


model Donation {
  id          Int      @id @default(autoincrement())
  campaignId  Int
  donorId     Int
  amount      Float
  message     String?
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())

  campaign    Campaign @relation(fields: [campaignId], references: [id])
  donor       User     @relation("UserDonations", fields: [donorId], references: [id])
}
